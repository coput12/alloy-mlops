{
  "uid": "alloy-overview",
  "title": "Alloy MLOps overview",
  "tags": ["alloy", "mlops"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "timeseries",
      "id": 1,
      "title": "HTTP requests (QPS)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ml_http_requests_total[1m]))",
          "legendFormat": "qps"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Predictions (1m rate)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ml_predictions_total[1m])) by (kind)",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Predict latency (P95)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(ml_predict_latency_seconds_bucket[5m])) by (le, kind))",
          "legendFormat": "p95 {{kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Predicted UTS value (avg)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(ml_prediction_value_sum) by (kind)",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Targets up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Host load (node)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1",
          "legendFormat": "load1"
        }
      ]
    }
  ]
}